  "toolScenarios": [
    {
      "id": "parallel-same-name-first-outcome-wins",
      "events": [
        {
          "kind": "tool_use",
          "id": "one",
          "name": "Read",
          "status": "requested"
        },
        {
          "kind": "tool_use",
          "id": "two",
          "name": "Read",
          "status": "requested"
        },
        {
          "kind": "tool_use",
          "id": "one",
          "name": "Read",
          "status": "running"
        },
        {
          "kind": "tool_use",
          "id": "two",
          "name": "Read",
          "status": "running"
        },
        {
          "kind": "tool_use",
          "id": "one",
          "name": "Read",
          "status": "ok",
          "durationMs": 10
        },
        {
          "kind": "tool_use",
          "id": "one",
          "name": "Read",
          "status": "error",
          "durationMs": 20
        },
        {
          "kind": "tool_use",
          "id": "two",
          "name": "Read",
          "status": "error",
          "durationMs": 12
        }
      ],
      "expected": [
        {
          "id": "one",
          "name": "Read",
          "status": "ok",
          "durationMs": 10
        },
        {
          "id": "two",
          "name": "Read",
          "status": "error",
          "durationMs": 12
        }
      ]
    },
    {
      "id": "result-before-start",
      "events": [
        {
          "kind": "tool_use",
          "id": "one",
          "name": "Read",
          "status": "error",
          "durationMs": 7
        },
        {
          "kind": "tool_use",
          "id": "one",
          "name": "Read",
          "status": "requested"
        },
        {
          "kind": "tool_use",
          "id": "one",
          "name": "Read",
          "status": "running"
        }
      ],
      "expected": [
        {
          "id": "one",
          "name": "Read",
          "status": "error",
          "durationMs": 7
        }
      ]
    },
    {
      "id": "late-result-resolves-unknown",
      "events": [
        {
          "kind": "tool_use",
          "id": "one",
          "name": "Read",
          "status": "unknown"
        },
        {
          "kind": "tool_use",
          "id": "one",
          "name": "Read",
          "status": "running"
        },
        {
          "kind": "tool_use",
          "id": "one",
          "name": "Read",
          "status": "ok",
          "durationMs": 9
        }
      ],
      "expected": [
        {
          "id": "one",
          "name": "Read",
          "status": "ok",
          "durationMs": 9
        }
      ]
    },
    {
      "id": "rejection-is-not-execution",
      "events": [
        {
          "kind": "tool_use",
          "id": "one",
          "name": "Read",
          "status": "requested"
        },
        {
          "kind": "tool_use",
          "id": "one",
          "name": "Read",
          "status": "rejected"
        },
        {
          "kind": "tool_use",
          "id": "one",
          "name": "Read",
          "status": "running"
        },
        {
          "kind": "tool_use",
          "id": "one",
          "name": "Read",
          "status": "ok"
        }
      ],
      "expected": [
        {
          "id": "one",
          "name": "Read",
          "status": "rejected"
        }
      ]
    },
    {
      "id": "future-status-is-unknown",
      "events": [
        {
          "kind": "tool_use",
          "id": "one",
          "name": "Read",
          "status": "future-status"
        },
        {
          "kind": "tool_use",
          "id": "one",
          "name": "Read",
          "status": "running"
        }
      ],
      "expected": [
        {
          "id": "one",
          "name": "Read",
          "status": "unknown"
        }
      ]
    },
    {
      "id": "disconnect-does-not-prove-results",
      "events": [
        {
          "kind": "tool_use",
          "id": "one",
          "name": "Read",
          "status": "requested"
        },
        {
          "kind": "tool_use",
          "id": "two",
          "name": "Read",
          "status": "running"
        }
      ],
      "expected": [
        {
          "id": "one",
          "name": "Read",
          "status": "unknown"
        },
        {
          "id": "two",
          "name": "Read",
          "status": "unknown"
        }
      ]
    }
  ],
