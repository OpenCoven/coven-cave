{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "bundle": {
    "resources": [
      "resources/server-archive/**/*",
      "resources/node/**/*",
      "resources/whisper/**/*",
      "resources/piper/**/*",
      "resources/kokoro/**/*",
      "resources/tools/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "fragmentPaths": [
          "./windows/fragments/sidecar-cache-cleanup.wxs"
        ],
        "componentRefs": [
          "SidecarRuntimeCleanupAnchor"
        ]
      }
    }
  }
}
