{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/surface-claim-guard.mjs\"",
            "statusMessage": "Checking surface claims…",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write|NotebookEdit"
      },
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/worktree-guard.mjs\"",
            "statusMessage": "Checking worktree/branch safety…",
            "timeout": 15,
            "type": "command"
          },
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/worktree-autolock.mjs\"",
            "statusMessage": "Protecting at-risk worktrees…",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/worktree-retention-push.mjs\"",
            "statusMessage": "Retaining commits on origin…",
            "timeout": 60,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(git fetch *)",
      "Bash(pnpm lint)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint:design)",
      "Bash(pnpm codemod:design:check)",
      "Bash(pnpm check:tests-wired)",
      "Bash(pnpm exec tsc --noEmit *)",
      "mcp__claude-design__read_file",
      "mcp__claude-design__list_files",
      "mcp__claude-design__list_projects"
    ]
  }
}
