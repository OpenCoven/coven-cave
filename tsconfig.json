{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@opencoven/research-host/*": [
        "./src/lib/research-host/*"
      ],
      "@opencoven/research-runtime": [
        "./src/lib/server/research-package-absent.ts"
      ],
      "@opencoven/research-client": [
        "./src/components/role-surfaces/research-package-absent.tsx"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "./.next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src-tauri",
    "marketplace/plugins"
  ]
}
