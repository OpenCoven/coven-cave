{
  "additionalProperties": false,
  "properties": {
    "audience": {
      "maxLength": 500,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "briefId": {
      "maxLength": 128,
      "minLength": 7,
      "pattern": "^brief-[a-z0-9-]+$",
      "type": "string"
    },
    "constraints": {
      "additionalProperties": false,
      "properties": {
        "bannedPhrases": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 128,
          "type": "array",
          "uniqueItems": true
        },
        "maxPosts": {
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "minPosts": {
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "requireAltText": {
          "type": "boolean"
        },
        "requiredClaimIds": {
          "items": {
            "maxLength": 128,
            "minLength": 7,
            "pattern": "^claim-[a-z0-9-]+$",
            "type": "string"
          },
          "maxItems": 128,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "minPosts",
        "maxPosts",
        "requiredClaimIds",
        "bannedPhrases",
        "requireAltText"
      ],
      "type": "object"
    },
    "notes": {
      "maxLength": 2000,
      "type": "string"
    },
    "objectiveWeights": {
      "additionalProperties": false,
      "properties": {
        "accessibility": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "coherence": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "engagement": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "factuality": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "provenance": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        "voice": {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "factuality",
        "provenance",
        "accessibility",
        "voice",
        "coherence",
        "engagement"
      ],
      "type": "object"
    },
    "protocolVersion": {
      "const": "opencoven.tweet-thread.v1",
      "type": "string"
    },
    "topic": {
      "maxLength": 500,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    }
  },
  "required": [
    "protocolVersion",
    "briefId",
    "topic",
    "audience",
    "objectiveWeights",
    "constraints"
  ],
  "type": "object"
}
