{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "loopback-tailscale-app",
  "description": "lets the trusted main loopback webview open the installed Tailscale app with fixed arguments, for pairing recovery",
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "webviews": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*",
      "http://[\\:\\:1]:*/*"
    ]
  },
  "permissions": [
    "allow-open-tailscale-app"
  ]
}
