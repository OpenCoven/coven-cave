          "id": "one",
          "name": "Read",
          "status": "ok",
          "durationMs": 10
        },
        {
          "kind": "tool_use",
          "id": "one",
          "name": "Read",
          "status": "error",
          "durationMs": 20
        },
        {
          "kind": "tool_use",
          "id": "two",
          "name": "Read",
          "status": "error",
          "durationMs": 12
        }
      ],
      "expected": [
        {
          "id": "one",
          "name": "Read",
          "status": "ok",
          "durationMs": 10
        },
        {
          "id": "two",
          "name": "Read",
          "status": "error",
          "durationMs": 12
        }
      ]
