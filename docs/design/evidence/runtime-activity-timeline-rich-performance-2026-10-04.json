    "webBenchmarkSource": "import assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nimport { pathToFileURL } from 'node:url';\nimport { performance } from 'node:perf_hooks';\n\nconst root = process.cwd();\nconst { chatActivityTimeline } = await import(pathToFileURL(`${root}/src/lib/chat-activity-timeline.ts`));\nconst corpus = JSON.parse(readFileSync(`${root}/apps/ios/CovenCave/CovenCaveTests/Fixtures/runtime-timeline-v1.json`, 'utf8'));\nconst template = corpus.scenarios[0].tools[0];\nconst records = [];\nfor (const shape of ['prose', 'fenced']) {\n  for (const count of [30, 120, 1000]) {\n    let text = '';\n    const tools = [];\n    for (let index = 0; index < count; index++) {\n      const tool = structuredClone(template);\n      tool.id = `call-${index}`;\n      tool.activity.callId = tool.id;\n      tool.activity.sequence = index;\n      tool.textOffset = text.length;\n      tools.push(tool);\n      text += `Observation ${index}: \ud83e\uddd9 caf\u00e9.\\n\\n`;\n      if (shape === 'fenced') text += `\\x60\\x60\\x60text\\nfirst ${index}\\n\\nsecond ${index}\\n\\x60\\x60\\x60\\n\\n`;\n    }\n    // Exercise the same terminal public records as the renderer; no tool runs.\n    const samples = [];\n    for (let iteration = 0; iteration < 9; iteration++) {\n      const start = performance.now();\n      const entries = chatActivityTimeline(text, tools, []);\n      const elapsed = performance.now() - start;\n      assert.equal(entries.length, 2 * count);\n      assert.equal(entries.filter(e => e.kind === 'text').map(e => e.text).join(''), text);\n      assert.deepEqual(entries.filter(e => e.kind === 'tool').map(e => e.tool.id), tools.map(t => t.id));\n      if (iteration >= 2) samples.push(elapsed);\n    }\n    const ordered = [...samples].sort((a, b) => a - b);\n    records.push({ shape, count, utf16Length: text.length, samplesMs: samples, medianMs: ordered[3], maxMs: ordered.at(-1) });\n  }\n}\nconsole.log(JSON.stringify({ scope: 'warm pure projection only; excludes DOM, WebKit, network and physical-device measurements', runtime: process.version, records }, null, 2));\n",
    "interpretation": "The 1000-event fenced workload median fell from 25.071 ms to 12.700 ms (49.3%). The 120-event fenced case fell from 1.495 to 1.275 ms. Other shapes include neutral/slower samples; this is not a universal speedup. The 1000-event case is stress beyond the current native 120-step retention cap. No timing assertion or CI threshold was introduced."
  },
