{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "loopback-update-links",
  "description": "allows only the trusted main loopback webview to open a validated Coven Cave release page or release asset in the system browser",
  "webviews": ["main"],
  "platforms": ["linux", "macOS", "windows"],
  "remote": {
    "urls": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*",
      "http://[\\:\\:1]:*/*"
    ]
  },
  "permissions": ["allow-open-update-release-url"]
}
