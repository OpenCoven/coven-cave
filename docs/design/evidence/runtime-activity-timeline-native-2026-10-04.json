  "scope": "Native chronological reasoning, prose and tool presentation using the shared observation and UTF-16 contract. Model menus retain only the newest supported member of each known family.",
  "simulator": {
    "id": "9DF2F308-20E6-4410-8A6D-FE40502EADA1",
    "device": "iPhone 16 Pro",
    "os": "iOS 26.5"
