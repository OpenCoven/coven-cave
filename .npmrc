strict-dep-builds=false
only-allow=pnpm
# Never reuse a native build from the pnpm store (#6576). CI restores one store
# cache across Ubuntu images: a node-pty compiled on ubuntu-26.04 (glibc 2.42)
# cannot load on ubuntu-24.04, where the release runtime runs. With this off,
# the store holds only package archives and each install builds on its own host.
side-effects-cache=false
