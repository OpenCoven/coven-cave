{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "loopback-x-oauth",
  "description": "allows only the trusted main loopback webview to open X OAuth in the system browser",
  "webviews": ["main"],
  "remote": {
    "urls": [
      "http://localhost:*/*",
      "http://127.0.0.1:*/*",
      "http://[\\:\\:1]:*/*"
    ]
  },
  "permissions": ["allow-shell-open"]
}
