  "scenarios": [
    {
      "id": "discovery.valid-composition",
      "description": "A completed discovery job binds its ordered proposals to the sealed Context Pack.",
      "validator": "topic-discovery-composition",
      "inputs": {
        "contextPack": "context-pack",
        "job": "job",
        "proposals": ["proposal-one", "proposal-two"]
      },
      "expected": {
        "ok": true
      }
    },
    {
      "id": "discovery.research-run-pack",
      "description": "A research-run Context Pack cannot authorize topic discovery.",
      "validator": "topic-discovery-composition",
      "inputs": {
        "contextPack": "research-run-context-pack",
        "job": "job",
        "proposals": ["proposal-one", "proposal-two"]
      },
      "expected": {
        "ok": false,
        "stage": "composition",
        "code": "semantic_conflict",
        "path": "$.contextPack.purpose"
      }
    },
    {
      "id": "discovery.wrong-pack-id",
      "description": "The discovery job must name the supplied Context Pack.",
      "validator": "topic-discovery-composition",
      "inputs": {
        "contextPack": "context-pack",
        "job": "job-wrong-pack",
        "proposals": ["proposal-one", "proposal-two"]
      },
      "expected": {
        "ok": false,
        "stage": "composition",
        "code": "semantic_conflict",
        "path": "$.contextPackId"
      }
    },
    {
      "id": "discovery.wrong-pack-digest",
      "description": "The discovery job must bind the supplied Context Pack digest.",
      "validator": "topic-discovery-composition",
      "inputs": {
        "contextPack": "context-pack",
        "job": "job-wrong-digest",
        "proposals": ["proposal-one", "proposal-two"]
      },
      "expected": {
        "ok": false,
        "stage": "composition",
        "code": "semantic_conflict",
        "path": "$.contextPackDigest"
      }
    },
    {
      "id": "discovery.missing-proposal",
      "description": "A persisted proposal cannot be omitted from composition.",
      "validator": "topic-discovery-composition",
      "inputs": {
        "contextPack": "context-pack",
        "job": "job",
        "proposals": ["proposal-one"]
      },
      "expected": {
        "ok": false,
        "stage": "composition",
        "code": "semantic_conflict",
        "path": "$.proposalIds"
      }
    },
    {
      "id": "discovery.extra-proposal",
      "description": "An unpersisted proposal cannot be added to composition.",
      "validator": "topic-discovery-composition",
      "inputs": {
        "contextPack": "context-pack",
        "job": "job",
        "proposals": ["proposal-one", "proposal-two", "proposal-extra"]
      },
      "expected": {
        "ok": false,
        "stage": "composition",
        "code": "semantic_conflict",
        "path": "$.proposalIds"
      }
    },
    {
      "id": "discovery.swapped-proposals",
      "description": "Persisted proposal order is authoritative.",
      "validator": "topic-discovery-composition",
      "inputs": {
        "contextPack": "context-pack",
        "job": "job",
        "proposals": ["proposal-two", "proposal-one"]
      },
      "expected": {
        "ok": false,
        "stage": "composition",
        "code": "semantic_conflict",
        "path": "$.proposalIds[0]"
      }
    },
    {
      "id": "discovery.wrong-job-id",
      "description": "Every proposal must name the composing discovery job.",
      "validator": "topic-discovery-composition",
      "inputs": {
        "contextPack": "context-pack",
        "job": "job",
        "proposals": ["proposal-wrong-job", "proposal-two"]
      },
      "expected": {
        "ok": false,
        "stage": "composition",
        "code": "semantic_conflict",
        "path": "$.proposals[0].discoveryJobId"
      }
    },
    {
      "id": "discovery.wrong-proposal-pack-id",
      "description": "Every proposal must name the composing Context Pack.",
      "validator": "topic-discovery-composition",
      "inputs": {
        "contextPack": "context-pack",
        "job": "job",
        "proposals": ["proposal-wrong-pack", "proposal-two"]
      },
      "expected": {
        "ok": false,
        "stage": "composition",
        "code": "semantic_conflict",
        "path": "$.proposals[0].contextPackId"
      }
    },
    {
      "id": "discovery.missing-resource",
      "description": "Proposal evidence must resolve to a sealed Context Pack resource.",
      "validator": "topic-discovery-composition",
      "inputs": {
        "contextPack": "context-pack",
        "job": "job",
        "proposals": ["proposal-missing-resource", "proposal-two"]
      },
      "expected": {
        "ok": false,
        "stage": "composition",
        "code": "semantic_conflict",
        "path": "$.proposals[0].evidence[0].resourceId"
      }
    },
    {
      "id": "discovery.selector-mismatch",
      "description": "Proposal evidence selectors must equal their sealed resource selectors.",
      "validator": "topic-discovery-composition",
      "inputs": {
        "contextPack": "context-pack",
        "job": "job",
        "proposals": ["proposal-selector-mismatch", "proposal-two"]
      },
      "expected": {
        "ok": false,
        "stage": "composition",
        "code": "semantic_conflict",
        "path": "$.proposals[0].evidence[0].selector"
      }
    },
    {
      "id": "discovery.proposal-before-request",
      "description": "A proposal cannot predate its discovery request.",
      "validator": "topic-discovery-composition",
      "inputs": {
        "contextPack": "context-pack",
        "job": "job",
        "proposals": ["proposal-before-request", "proposal-two"]
      },
      "expected": {
        "ok": false,
        "stage": "composition",
        "code": "semantic_conflict",
        "path": "$.proposals[0].createdAt"
      }
    },
    {
      "id": "discovery.proposal-after-finish",
      "description": "A proposal cannot follow discovery completion.",
      "validator": "topic-discovery-composition",
      "inputs": {
        "contextPack": "context-pack",
        "job": "job",
        "proposals": ["proposal-after-finish", "proposal-two"]
      },
      "expected": {
        "ok": false,
        "stage": "composition",
        "code": "semantic_conflict",
        "path": "$.proposals[0].createdAt"
      }
    },
    {
      "id": "discovery.started-before-request",
      "description": "A discovery job cannot start before it is requested.",
      "validator": "topic-discovery-composition",
      "inputs": {
        "contextPack": "context-pack",
        "job": "job-started-before-request",
        "proposals": ["proposal-one", "proposal-two"]
      },
      "expected": {
        "ok": false,
        "stage": "parse",
        "input": "job",
        "code": "semantic_conflict",
        "path": "$.startedAt"
      }
    },
    {
      "id": "discovery.finished-before-started",
      "description": "A discovery job cannot finish before it starts.",
      "validator": "topic-discovery-composition",
      "inputs": {
        "contextPack": "context-pack",
        "job": "job-finished-before-started",
        "proposals": ["proposal-one", "proposal-two"]
      },
      "expected": {
        "ok": false,
        "stage": "parse",
        "input": "job",
        "code": "semantic_conflict",
        "path": "$.finishedAt"
      }
    }
