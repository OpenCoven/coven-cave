  "scenarios": [
    {
      "id": "manifest.assembling-to-final",
      "description": "A valid assembling manifest advances to a linked final revision.",
      "validator": "run-manifest-revision",
      "inputs": {
        "previous": "assembling",
        "next": "final-from-assembling"
      },
      "options": {
        "contextConsent": "7-days"
      },
      "expected": {
        "ok": true
      }
    },
    {
      "id": "manifest.assembling-to-final-scheduled-shortening",
      "description": "An assembling manifest may finalize with shorter retention after scheduling deletion.",
      "validator": "run-manifest-revision",
      "inputs": {
        "previous": "assembling",
        "next": "scheduled-shortening-from-assembling"
      },
      "options": {
        "contextConsent": "7-days"
      },
      "expected": {
        "ok": true
      }
    },
    {
      "id": "manifest.assembling-scheduled-to-active-rollback",
      "description": "Fresh-consent metadata alone cannot cancel a scheduled deletion while an assembling manifest finalizes.",
      "validator": "run-manifest-revision",
      "inputs": {
        "previous": "assembling-scheduled-previous",
        "next": "active-after-assembling-scheduled"
      },
      "options": {
        "freshConsent": true,
        "contextConsent": "7-days"
      },
      "expected": {
        "ok": false,
        "stage": "composition",
        "code": "semantic_conflict",
        "path": "$.deletion.status"
      }
    },
    {
      "id": "manifest.assembling-pending-to-active-rollback",
      "description": "A pending deletion cannot return to active retention while an assembling manifest finalizes.",
      "validator": "run-manifest-revision",
      "inputs": {
        "previous": "assembling-pending-previous",
        "next": "active-after-assembling-pending"
      },
      "options": {
        "contextConsent": "7-days"
      },
      "expected": {
        "ok": false,
        "stage": "composition",
        "code": "semantic_conflict",
        "path": "$.deletion.status"
      }
    },
    {
      "id": "manifest.assembling-partial-failure-to-active-rollback",
      "description": "A partial deletion failure cannot return to active retention while an assembling manifest finalizes.",
      "validator": "run-manifest-revision",
      "inputs": {
        "previous": "assembling-partial-failure-previous",
        "next": "active-after-assembling-partial-failure"
      },
      "options": {
        "contextConsent": "7-days"
      },
      "expected": {
        "ok": false,
        "stage": "composition",
        "code": "semantic_conflict",
        "path": "$.deletion.status"
      }
    },
    {
      "id": "manifest.assembling-scheduled-to-final-pending",
      "description": "An assembling manifest may finalize while advancing scheduled deletion to pending.",
      "validator": "run-manifest-revision",
      "inputs": {
        "previous": "assembling-scheduled-previous",
        "next": "pending-after-assembling-scheduled"
      },
      "options": {
        "contextConsent": "7-days"
      },
      "expected": {
        "ok": true
      }
    },
    {
      "id": "manifest.assembling-to-final-unscheduled-shortening",
      "description": "An assembling manifest cannot finalize with shorter retention while deletion remains unscheduled.",
      "validator": "run-manifest-revision",
      "inputs": {
        "previous": "assembling",
        "next": "unscheduled-shortening-from-assembling"
      },
      "options": {
        "contextConsent": "7-days"
      },
      "expected": {
        "ok": false,
        "stage": "parse",
        "input": "next",
        "code": "semantic_conflict",
        "path": "$.retention.status"
      }
    },
    {
      "id": "manifest.partial-usage",
      "description": "A linked final manifest accepts correct partial usage completeness and accounting.",
      "validator": "run-manifest-revision",
      "inputs": {
        "previous": "assembling",
        "next": "partial-usage-final"
      },
      "options": {
        "contextConsent": "7-days"
      },
      "expected": {
        "ok": true
      }
    },
    {
      "id": "manifest.changed-manifest-id",
      "description": "A linked revision cannot change the manifest identity.",
      "validator": "run-manifest-revision",
      "inputs": {
        "previous": "final",
        "next": "changed-manifest-id"
      },
      "expected": {
        "ok": false,
        "stage": "composition",
        "code": "semantic_conflict",
        "path": "$.id"
      }
    },
    {
      "id": "manifest.changed-run-id",
      "description": "A linked revision cannot move to another run.",
      "validator": "run-manifest-revision",
      "inputs": {
        "previous": "final",
        "next": "changed-run-id"
      },
      "expected": {
        "ok": false,
        "stage": "composition",
        "code": "semantic_conflict",
        "path": "$.runId"
      }
    },
    {
      "id": "manifest.broken-previous-digest",
      "description": "A linked revision must identify the immediately preceding manifest digest.",
      "validator": "run-manifest-revision",
      "inputs": {
        "previous": "final",
